<% content_for :title, "Set up a new passkey" %>
<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<h1>Set up a new passkey</h1>

<p>Resetting for <strong><%= @user.email %></strong>. Any passkeys you had before will be removed.</p>

<%= tag.form data: { controller: "passkey", passkey_mode_value: "register",
                     passkey_options_url_value: options_passkey_reset_path(params[:token]),
                     passkey_submit_url_value: passkey_reset_path(params[:token]),
                     passkey_submit_method_value: "PATCH",
                     action: "submit->passkey#run" } do %>
  <p>
    <label for="nickname">Passkey name (optional)</label><br>
    <input type="text" id="nickname" placeholder="e.g. MacBook" data-passkey-target="nickname">
  </p>
  <p><button type="submit" data-passkey-target="button">Create a new passkey</button></p>
  <p role="alert" data-passkey-target="error" style="color: #b00020"></p>
<% end %>
